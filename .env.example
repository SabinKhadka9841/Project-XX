# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit real keys.

# ── Supabase ─────────────────────────────────────────────
# Dashboard -> Project Settings -> API.
#
# Pick a region close to your users when creating the project: it can't
# be changed afterwards, and every database call is a round trip. This
# project moved from Seoul to Sydney for exactly that reason — page
# loads went from ~2-4s to under a second.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<the "anon public" key>

# The "service_role secret" key from the same page. It bypasses every
# row-level security rule, so it must only ever be used server-side —
# here, only by the OnlyOffice save callback, which is called
# machine-to-machine with no signed-in user to check.
SUPABASE_SERVICE_ROLE_KEY=<the "service_role secret" key>

# Set when the project is created. Needed by `supabase link` and for
# direct database access. Supabase won't show it again, so keep it in a
# password manager.
SUPABASE_DB_PASSWORD=<your database password>

# ── Frontend ─────────────────────────────────────────────
# The origin the separate frontend app runs on, so the browser is
# allowed to call this backend's /api/* routes. This backend runs on
# port 4000 (see package.json), leaving 3000 free for the frontend.
FRONTEND_ORIGIN=http://localhost:3000

# ── OnlyOffice ───────────────────────────────────────────
# The in-browser document editor runs in Docker. It refuses to open a
# document unless the config we send is signed with a shared secret.
#
# Make up any long random string, put it below, and pass the SAME value
# to the container so the two agree:
#
#   docker run -d -p 8080:80 \
#     -e JWT_SECRET="<the same value as below>" \
#     --name onlyoffice-documentserver onlyoffice/documentserver
#
# Pass JWT_SECRET explicitly — do not let the container pick its own.
# Left to itself it generates a NEW random secret on every single
# start (not just the first), which silently breaks the editor with
# "The document security token is not correctly formed" after any
# restart. Pinning it here means restarts are safe.
ONLYOFFICE_JWT_SECRET=<any long random string, matching the container>
