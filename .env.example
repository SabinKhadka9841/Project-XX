# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit real keys.

# ── Supabase ─────────────────────────────────────────────
# Dashboard -> Project Settings -> API.
#
# Pick a region close to your users when creating the project: it can't
# be changed afterwards, and every database call is a round trip. This
# project moved from Seoul to Sydney for exactly that reason — page
# loads went from ~2-4s to under a second.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<the "anon public" key>

# The "service_role secret" key from the same page. It bypasses every
# row-level security rule, so it must only ever be used server-side —
# here, only by the OnlyOffice save callback, which is called
# machine-to-machine with no signed-in user to check.
SUPABASE_SERVICE_ROLE_KEY=<the "service_role secret" key>

# Set when the project is created. Needed by `supabase link` and for
# direct database access. Supabase won't show it again, so keep it in a
# password manager.
SUPABASE_DB_PASSWORD=<your database password>

# ── Frontend ─────────────────────────────────────────────
# The origin the separate frontend app runs on, so the browser is
# allowed to call this backend's /api/* routes. This backend runs on
# port 4000 (see package.json), leaving 3000 free for the frontend.
FRONTEND_ORIGIN=http://localhost:3000

# ── Collabora (the in-browser editor) ────────────────────
# Replaced OnlyOffice, whose Community build cannot have its branding
# removed at all (the file needed to render a re-branded editor simply
# isn't in the image). Collabora permits it under its licence.
#
# Runs in Docker:
#   docker run -t -d -p 9980:9980 --name collabora \
#     -e "aliasgroup1=http://host\\.docker\\.internal:4000" \
#     -e "extra_params=--o:ssl.enable=false --o:ssl.termination=false \
#         --o:net.frame_ancestors=http://localhost:4000" \
#     collabora/code
#
# aliasgroup1 tells Collabora our app is an allowed WOPI host;
# frame_ancestors lets our page embed the editor in an iframe.
COLLABORA_URL=http://localhost:9980

# How Collabora reaches THIS app from inside its container, where
# "localhost" would mean the container itself.
WOPI_HOST=http://host.docker.internal:4000
APP_ORIGIN=http://localhost:4000

# Signs the tokens the editor uses to fetch and save a document. Anyone
# holding this can forge access to any file, so treat it like the
# service role key. Any long random string.
WOPI_TOKEN_SECRET=<a long random string>
